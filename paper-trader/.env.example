# Copy this file to .env and fill in your OpenAI key. Never commit .env.
OPENAI_API_KEY=

# Virtual starting balance and risk limits (paper mode only)
TRADING_PAPER_SOL=1
TRADING_COOLDOWN_MINUTES=60
TRADING_MAX_POSITION_FRACTION=0.2
TRADING_MAX_BUYS_PER_CYCLE=2
TRADING_MIN_LIQUIDITY_USD=50000
TRADING_MIN_VOLUME_USD=100000
TRADING_MIN_PAIR_AGE_HOURS=24
TRADING_SLIPPAGE_BPS=100
TRADING_OPENAI_MODEL=gpt-4o
