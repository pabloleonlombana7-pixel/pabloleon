{
  "name": "stoic-paper-trader",
  "private": true,
  "type": "module",
  "description": "Runs the Modern Stoic trading cycle in paper mode without the full elizaOS monorepo.",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node dist/run.mjs",
    "once": "node build.mjs && node dist/run.mjs --once",
    "report": "node build.mjs && node dist/run.mjs --report"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@solana/web3.js": "1.95.8",
    "bignumber.js": "9.1.2",
    "esbuild": "0.24.2"
  }
}
